{
  "name": "mini-pos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "test:server": "npm --prefix server test",
    "test:frontend": "node --test --test-concurrency=1 test/barcode.test.js test/refund-reporting.test.js test/hold-recall.test.js test/money.test.js",
    "test": "npm run test:frontend && npm run test:server",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@tailwindcss/vite": "^4.2.2",
    "@vercel/analytics": "^2.0.1",
    "@zxing/browser": "0.1.5",
    "chart.js": "^4.5.1",
    "express": "^5.3.0",
    "html2pdf.js": "^0.14.0",
    "pg": "^8.23.1",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.2.2",
    "vue": "^3.5.32",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.0.4",
    "vue-tsc": "^3.3.13"
  }
}
